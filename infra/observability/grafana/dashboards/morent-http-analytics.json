{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "links": [{"title": "Overview", "type": "dashboard", "uid": "morent-overview"}, {"title": "User Flows", "type": "dashboard", "uid": "morent-user-flows"}],
  "panels": [
    {
      "datasource": {"type": "elasticsearch", "uid": "Elasticsearch-logs"},
      "description": "Все HTTP-запросы из access-log (app.log_type=http или msg=http_request).",
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "line", "fillOpacity": 25, "lineWidth": 1, "stacking": {"mode": "normal"}}, "unit": "short"}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi"}},
      "targets": [{
        "alias": "",
        "bucketAggs": [
          {"field": "@timestamp", "id": "2", "settings": {"interval": "auto", "min_doc_count": 0}, "type": "date_histogram"},
          {"field": "service.name.keyword", "id": "3", "settings": {"min_doc_count": 1, "order": "desc", "orderBy": "_count", "size": "10"}, "type": "terms"}
        ],
        "metrics": [{"id": "1", "type": "count"}],
        "query": "app.log_type:http OR app.msg:\"http_request\"",
        "refId": "A",
        "timeField": "@timestamp"
      }],
      "title": "HTTP request rate by service",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "elasticsearch", "uid": "Elasticsearch-logs"},
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "line", "fillOpacity": 15, "lineWidth": 1}, "unit": "ms"}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi"}},
      "targets": [{
        "bucketAggs": [
          {"field": "@timestamp", "id": "2", "settings": {"interval": "auto"}, "type": "date_histogram"},
          {"field": "service.name.keyword", "id": "3", "settings": {"size": "8"}, "type": "terms"}
        ],
        "metrics": [{"field": "app.duration_ms", "id": "1", "type": "avg"}],
        "query": "(app.log_type:http OR app.msg:\"http_request\") AND service.name:$service",
        "refId": "A",
        "timeField": "@timestamp"
      }],
      "title": "Avg response time by service",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "elasticsearch", "uid": "Elasticsearch-logs"},
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "bars", "fillOpacity": 80}, "unit": "short"}},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8},
      "id": 3,
      "options": {"legend": {"displayMode": "list", "placement": "right", "showLegend": true}, "orientation": "horizontal"},
      "targets": [{
        "bucketAggs": [{"field": "app.status", "id": "2", "settings": {"min_doc_count": 1, "order": "desc", "orderBy": "_count", "size": "15"}, "type": "terms"}],
        "metrics": [{"id": "1", "type": "count"}],
        "query": "(app.log_type:http OR app.msg:\"http_request\") AND service.name:$service",
        "refId": "A",
        "timeField": "@timestamp"
      }],
      "title": "HTTP status codes",
      "type": "barchart"
    },
    {
      "datasource": {"type": "elasticsearch", "uid": "Elasticsearch-logs"},
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "bars", "fillOpacity": 80}, "unit": "short"}},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8},
      "id": 4,
      "options": {"legend": {"displayMode": "list", "placement": "right", "showLegend": true}, "orientation": "horizontal"},
      "targets": [{
        "bucketAggs": [{"field": "app.method.keyword", "id": "2", "settings": {"size": "10"}, "type": "terms"}],
        "metrics": [{"id": "1", "type": "count"}],
        "query": "(app.log_type:http OR app.msg:\"http_request\") AND service.name:$service",
        "refId": "A",
        "timeField": "@timestamp"
      }],
      "title": "HTTP methods",
      "type": "barchart"
    },
    {
      "datasource": {"type": "elasticsearch", "uid": "Elasticsearch-logs"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "yellow", "value": 1}, {"color": "red", "value": 10}]}, "unit": "short"}},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8},
      "id": 5,
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["sum"], "fields": "", "values": false}},
      "targets": [{
        "bucketAggs": [{"field": "@timestamp", "id": "2", "settings": {"interval": "auto"}, "type": "date_histogram"}],
        "metrics": [{"id": "1", "type": "count"}],
        "query": "(app.log_type:http OR app.msg:\"http_request\") AND service.name:$service AND (app.status:[500 TO 599] OR level:ERROR)",
        "refId": "A",
        "timeField": "@timestamp"
      }],
      "title": "5xx / ERROR count",
      "type": "stat"
    },
    {
      "datasource": {"type": "elasticsearch", "uid": "Elasticsearch-logs"},
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "line", "fillOpacity": 10}, "unit": "short"}},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 16},
      "id": 6,
      "options": {"legend": {"displayMode": "table", "placement": "right", "showLegend": true}, "tooltip": {"mode": "multi"}},
      "targets": [{
        "bucketAggs": [
          {"field": "@timestamp", "id": "2", "settings": {"interval": "auto"}, "type": "date_histogram"},
          {"field": "app.path.keyword", "id": "3", "settings": {"min_doc_count": 1, "order": "desc", "orderBy": "_count", "size": "12"}, "type": "terms"}
        ],
        "metrics": [{"id": "1", "type": "count"}],
        "query": "(app.log_type:http OR app.msg:\"http_request\") AND service.name:$service AND NOT app.path:\"/health\" AND NOT app.path:\"/ready\"",
        "refId": "A",
        "timeField": "@timestamp"
      }],
      "title": "Top API paths",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "elasticsearch", "uid": "Elasticsearch-logs"},
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "line", "fillOpacity": 20}, "unit": "short"}},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 16},
      "id": 7,
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi"}},
      "targets": [{
        "bucketAggs": [{"field": "@timestamp", "id": "2", "settings": {"interval": "auto"}, "type": "date_histogram"}],
        "metrics": [{"id": "1", "type": "count"}],
        "query": "(app.log_type:http OR app.msg:\"http_request\") AND service.name:$service AND (app.status:[400 TO 499])",
        "refId": "A",
        "timeField": "@timestamp"
      }],
      "title": "4xx client errors over time",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "elasticsearch", "uid": "Elasticsearch-logs"},
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 25},
      "id": 8,
      "options": {"dedupStrategy": "none", "enableLogDetails": true, "showLabels": false, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true},
      "targets": [{
        "bucketAggs": [{"field": "@timestamp", "id": "2", "settings": {"interval": "auto"}, "type": "date_histogram"}],
        "metrics": [{"id": "1", "settings": {"limit": "500"}, "type": "logs"}],
        "query": "(app.log_type:http OR app.msg:\"http_request\") AND service.name:$service AND (app.status:[500 TO 599] OR level:ERROR)",
        "refId": "A",
        "timeField": "@timestamp"
      }],
      "title": "Recent HTTP errors (logs)",
      "type": "logs"
    }
  ],
  "refresh": "15s",
  "schemaVersion": 40,
  "tags": ["morent", "elasticsearch", "http"],
  "templating": {
    "list": [
      {
        "current": {"selected": true, "text": "All", "value": "$__all"},
        "datasource": {"type": "elasticsearch", "uid": "Elasticsearch-logs"},
        "definition": "{\"find\": \"terms\", \"field\": \"service.name.keyword\"}",
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "service",
        "options": [],
        "query": "{\"find\": \"terms\", \"field\": \"service.name.keyword\"}",
        "refresh": 1,
        "type": "query"
      }
    ]
  },
  "time": {"from": "now-1h", "to": "now"},
  "timezone": "browser",
  "title": "Morent HTTP Analytics",
  "uid": "morent-http-analytics",
  "version": 1
}
