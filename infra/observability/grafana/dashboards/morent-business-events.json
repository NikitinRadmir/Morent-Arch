{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "links": [{"title": "User Flows", "type": "dashboard", "uid": "morent-user-flows"}],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "id": 300,
      "title": "Kafka & domain events",
      "type": "row"
    },
    {
      "datasource": {"type": "elasticsearch", "uid": "Elasticsearch-logs"},
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "line", "fillOpacity": 25, "stacking": {"mode": "normal"}}, "unit": "short"}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 1},
      "id": 1,
      "targets": [{
        "bucketAggs": [
          {"field": "@timestamp", "id": "2", "settings": {"interval": "auto"}, "type": "date_histogram"},
          {"field": "app.event_type.keyword", "id": "3", "settings": {"size": "15"}, "type": "terms"}
        ],
        "metrics": [{"id": "1", "type": "count"}],
        "query": "message:*kafka*event*published* OR app.event_type:*",
        "refId": "A",
        "timeField": "@timestamp"
      }],
      "title": "Kafka events published (by event_type)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "elasticsearch", "uid": "Elasticsearch-logs"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "red", "value": 1}]}, "unit": "short"}},
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 1},
      "id": 2,
      "options": {"colorMode": "background", "reduceOptions": {"calcs": ["sum"], "fields": "", "values": false}},
      "targets": [{
        "bucketAggs": [{"field": "@timestamp", "id": "2", "settings": {"interval": "auto"}, "type": "date_histogram"}],
        "metrics": [{"id": "1", "type": "count"}],
        "query": "message:*kafka*publish*failed* OR message:*kafka*fetch*failed* OR message:*kafka*commit*failed*",
        "refId": "A",
        "timeField": "@timestamp"
      }],
      "title": "Kafka errors",
      "type": "stat"
    },
    {
      "datasource": {"type": "elasticsearch", "uid": "Elasticsearch-logs"},
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "line"}, "unit": "short"}},
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 1},
      "id": 3,
      "targets": [{
        "bucketAggs": [
          {"field": "@timestamp", "id": "2", "settings": {"interval": "auto"}, "type": "date_histogram"},
          {"field": "service.name.keyword", "id": "3", "settings": {"size": "6"}, "type": "terms"}
        ],
        "metrics": [{"id": "1", "type": "count"}],
        "query": "message:*bank*kafka* OR message:*bank*response*",
        "refId": "A",
        "timeField": "@timestamp"
      }],
      "title": "Bank Kafka integration",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 9},
      "id": 301,
      "title": "Email pipeline",
      "type": "row"
    },
    {
      "datasource": {"type": "elasticsearch", "uid": "Elasticsearch-logs"},
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "line", "fillOpacity": 20, "stacking": {"mode": "normal"}}, "unit": "short"}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 10},
      "id": 4,
      "targets": [{
        "bucketAggs": [
          {"field": "@timestamp", "id": "2", "settings": {"interval": "auto"}, "type": "date_histogram"},
          {"field": "app.template.keyword", "id": "3", "settings": {"size": "12"}, "type": "terms"}
        ],
        "metrics": [{"id": "1", "type": "count"}],
        "query": "message:*email*event*published* OR app.template:*",
        "refId": "A",
        "timeField": "@timestamp"
      }],
      "title": "Email events queued (template)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "elasticsearch", "uid": "Elasticsearch-logs"},
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "line"}, "unit": "short"}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 10},
      "id": 5,
      "targets": [{
        "bucketAggs": [{"field": "@timestamp", "id": "2", "settings": {"interval": "auto"}, "type": "date_histogram"}],
        "metrics": [{"id": "1", "type": "count"}],
        "query": "service.name:emailservice-* OR message:*email*",
        "refId": "A",
        "timeField": "@timestamp"
      }],
      "title": "EmailService log volume",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 18},
      "id": 302,
      "title": "Rentals, reminders, integrations",
      "type": "row"
    },
    {
      "datasource": {"type": "elasticsearch", "uid": "Elasticsearch-logs"},
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "line"}, "unit": "short"}},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 19},
      "id": 6,
      "targets": [{
        "bucketAggs": [{"field": "@timestamp", "id": "2", "settings": {"interval": "auto"}, "type": "date_histogram"}],
        "metrics": [{"id": "1", "type": "count"}],
        "query": "message:*rental*reminder*",
        "refId": "A",
        "timeField": "@timestamp"
      }],
      "title": "Rental day reminders",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "elasticsearch", "uid": "Elasticsearch-logs"},
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "line"}, "unit": "short"}},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 19},
      "id": 7,
      "targets": [{
        "bucketAggs": [{"field": "@timestamp", "id": "2", "settings": {"interval": "auto"}, "type": "date_histogram"}],
        "metrics": [{"id": "1", "type": "count"}],
        "query": "app.log_type:integration OR message:integration",
        "refId": "A",
        "timeField": "@timestamp"
      }],
      "title": "External integrations (obslog)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "elasticsearch", "uid": "Elasticsearch-logs"},
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "line"}, "unit": "short"}},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 19},
      "id": 8,
      "targets": [{
        "bucketAggs": [
          {"field": "@timestamp", "id": "2", "settings": {"interval": "auto"}, "type": "date_histogram"},
          {"field": "service.name.keyword", "id": "3", "settings": {"size": "8"}, "type": "terms"}
        ],
        "metrics": [{"id": "1", "type": "count"}],
        "query": "message:*fallback* OR message:*search_start* OR message:*search_complete*",
        "refId": "A",
        "timeField": "@timestamp"
      }],
      "title": "Car aggregator search / fallback",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 27},
      "id": 303,
      "title": "Service heartbeats & errors",
      "type": "row"
    },
    {
      "datasource": {"type": "elasticsearch", "uid": "Elasticsearch-logs"},
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "line", "stacking": {"mode": "normal"}}, "unit": "short"}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 28},
      "id": 9,
      "targets": [{
        "bucketAggs": [
          {"field": "@timestamp", "id": "2", "settings": {"interval": "auto"}, "type": "date_histogram"},
          {"field": "service.name.keyword", "id": "3", "settings": {"size": "8"}, "type": "terms"}
        ],
        "metrics": [{"id": "1", "type": "count"}],
        "query": "app.log_type:heartbeat OR message:heartbeat",
        "refId": "A",
        "timeField": "@timestamp"
      }],
      "title": "Application heartbeats by service",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "elasticsearch", "uid": "Elasticsearch-logs"},
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "line", "fillOpacity": 20}, "unit": "short"}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 28},
      "id": 10,
      "targets": [{
        "bucketAggs": [
          {"field": "@timestamp", "id": "2", "settings": {"interval": "auto"}, "type": "date_histogram"},
          {"field": "service.name.keyword", "id": "3", "settings": {"size": "8"}, "type": "terms"}
        ],
        "metrics": [{"id": "1", "type": "count"}],
        "query": "level:ERROR OR app.level:ERROR OR message:*panic*",
        "refId": "A",
        "timeField": "@timestamp"
      }],
      "title": "Application errors by service",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "elasticsearch", "uid": "Elasticsearch-logs"},
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 36},
      "id": 11,
      "options": {"dedupStrategy": "none", "enableLogDetails": true, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true},
      "targets": [{
        "bucketAggs": [{"field": "@timestamp", "id": "2", "settings": {"interval": "auto"}, "type": "date_histogram"}],
        "metrics": [{"id": "1", "settings": {"limit": "300"}, "type": "logs"}],
        "query": "level:ERROR OR app.level:ERROR OR message:*failed* OR message:*panic*",
        "refId": "A",
        "timeField": "@timestamp"
      }],
      "title": "Recent errors & failures (logs)",
      "type": "logs"
    }
  ],
  "refresh": "15s",
  "schemaVersion": 40,
  "tags": ["morent", "elasticsearch", "kafka", "email"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "Morent Business Events",
  "uid": "morent-business-events",
  "version": 1
}
