{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "links": [{"title": "User Flows", "type": "dashboard", "uid": "morent-user-flows"}],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "id": 300,
      "title": "Kafka & domain events",
      "type": "row"
    },
    {
      "datasource": {"type": "elasticsearch", "uid": "Elasticsearch-logs"},
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "line", "fillOpacity": 25, "stacking": {"mode": "normal"}}, "unit": "short"}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 1},
      "id": 1,
      "targets": [{
        "bucketAggs": [
          {"field": "app.event_type", "id": "3", "settings": {"min_doc_count": 1, "order": "desc", "orderBy": "_count", "size": "15"}, "type": "terms"},
          {"field": "@timestamp", "id": "2", "settings": {"interval": "auto"}, "type": "date_histogram"}
        ],
        "metrics": [{"id": "1", "type": "count"}],
        "query": "_exists_:app.event_type",
        "refId": "A",
        "timeField": "@timestamp"
      }],
      "title": "Kafka events published (by event_type)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "elasticsearch", "uid": "Elasticsearch-logs"},
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "line", "fillOpacity": 20}, "unit": "short"}},
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 1},
      "id": 2,
      "targets": [{
        "bucketAggs": [
          {"field": "app.topic", "id": "3", "settings": {"min_doc_count": 1, "order": "desc", "orderBy": "_count", "size": "6"}, "type": "terms"},
          {"field": "@timestamp", "id": "2", "settings": {"interval": "auto"}, "type": "date_histogram"}
        ],
        "metrics": [{"id": "1", "type": "count"}],
        "query": "_exists_:app.topic",
        "refId": "A",
        "timeField": "@timestamp"
      }],
      "title": "Kafka messages by topic",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "elasticsearch", "uid": "Elasticsearch-logs"},
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "line"}, "unit": "short"}},
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 1},
      "id": 3,
      "targets": [{
        "bucketAggs": [
          {"field": "service.name", "id": "3", "settings": {"min_doc_count": 1, "order": "desc", "orderBy": "_count", "size": "6"}, "type": "terms"},
          {"field": "@timestamp", "id": "2", "settings": {"interval": "auto"}, "type": "date_histogram"}
        ],
        "metrics": [{"id": "1", "type": "count"}],
        "query": "app.topic:\"morent.bank.commands\"",
        "refId": "A",
        "timeField": "@timestamp"
      }],
      "title": "Bank Kafka integration",
      "type": "timeseries"
