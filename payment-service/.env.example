APP_ENV=dev
HTTP_ADDR=:8081
LOG_LEVEL=info

# Kafka — обработка команд банка от Morent backend
KAFKA_ENABLED=true
# В Docker Compose: kafka:9092 (сеть kafka_morent-kafka)
# Локально: localhost:9092
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC_BANK_COMMANDS=morent.bank.commands
KAFKA_TOPIC_BANK_RESPONSES=morent.bank.responses
KAFKA_GROUP_PAYMENT_BANK=payment-service-bank
