# ============================================
# Database Configuration (PostgreSQL)
# ============================================

# Для Docker Compose используйте DB_HOST=db
# Для локальной разработки используйте DB_HOST=localhost
DB_HOST=db
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=user_system_db
DB_EXTERNAL_PORT=5434
DB_PORT=5432
DB_SSL=disable

# ============================================
# Application Configuration
# ============================================

# Server
APP_PORT=8082
APP_ENV=development
APP_DEBUG=true

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_123456
JWT_EXPIRATION_HOURS=24

# ============================================
# CORS Configuration
# ============================================

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Origin,Content-Type,Accept,Authorization

# ============================================
# Logging Configuration
# ============================================

LOG_LEVEL=debug
LOG_FORMAT=json

# ============================================
# Rate Limiting (optional)
# ============================================

RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ============================================
# Kafka (синхронизация пользователей из Morent)
# ============================================
# docker compose -f infra/kafka/docker-compose.yml up -d
KAFKA_ENABLED=true
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC_USERS=morent.users
KAFKA_CONSUMER_GROUP=user-system-morent-sync
MORENT_COMPANY_NAME=Morent

# ============================================
# Docker Settings
# ============================================

# Очищать ли базу данных при старте приложения
# true - удалит все таблицы и создаст заново
# false - оставит существующие данные
CLEAR_DB_ON_START=false
