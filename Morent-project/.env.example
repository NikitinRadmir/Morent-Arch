#############################################
# Morent — пример .env (скопируйте в .env)
#############################################

# =============================================================================
# Режим A: всё через `docker compose up` в Morent-project (рекомендуется)
# =============================================================================
# Backend в контейнере → внешние сервисы на хосте через host.docker.internal.
# Запустите отдельно:
#   - generator-service на порту GENERATOR_PORT (по умолчанию 8081)
#   - car-aggregator на порту AGGREGATOR_PORT (по умолчанию 8080)
#
# Для режима A используйте значения AGGREGATOR_BASE_URL / GENERATOR_BASE_URL
# с host.docker.internal (см. блок ниже).

# =============================================================================
# Режим B: инфра в Docker, backend локально (`make backend` + `make frontend`)
# =============================================================================
# Раскомментируйте и подставьте в .env при локальном go run:
#   DB_HOST=localhost
#   DB_PORT=5433
#   MINIO_ENDPOINT=localhost:9000
#   MINIO_PUBLIC_ENDPOINT=localhost:9000
#   REDIS_ADDR=127.0.0.1:6379
#   GENERATOR_BASE_URL=http://localhost:8081
#   AGGREGATOR_BASE_URL=http://localhost:8080

# ---- Postgres ----
DB_USER=postgres
DB_PASSWORD=postgresmaster
DB_NAME=car_booking
DB_EXTERNAL_PORT=5433

# ---- Backend HTTP / gRPC ----
BACKEND_PORT=1488
GRPC_PORT=50051
FRONTEND_ORIGIN=http://localhost:5173

# ---- Внешние микросервисы (порты на хосте) ----
# Не используйте один и тот же порт для агрегатора и generator одновременно.
AGGREGATOR_PORT=8080
GENERATOR_PORT=8081

# URL для backend в Docker (режим A)
AGGREGATOR_BASE_URL=http://host.docker.internal:8080
GENERATOR_BASE_URL=http://host.docker.internal:8081

AGGREGATOR_TIMEOUT_SEC=35
AGGREGATOR_RETRY_COUNT=3

# ---- Сессии ----
SESSION_COOKIE_NAME=morent_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_DOMAIN=

# ---- MinIO ----
# В docker-compose backend получает MINIO_ENDPOINT=minio:9000 автоматически.
# Ниже — для локального backend (режим B).
MINIO_ENDPOINT=localhost:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=morent-media
MINIO_USE_SSL=false
MINIO_PORT_API=9000
MINIO_PORT_CONSOLE=9001

# ---- Redis (кэш каталога машин) ----
# В docker-compose подставляется REDIS_ADDR=redis:6379.
# Для локального backend: REDIS_ADDR=127.0.0.1:6379 или пусто — кэш выключен.
REDIS_PORT=6379
REDIS_ADDR=
REDIS_PASSWORD=
REDIS_DB=0
CARS_CACHE_TTL_SEC=60

# ---- БД (только для локального backend, режим B) ----
DB_HOST=localhost
DB_PORT=5433

# ---- Frontend ----
VITE_API_URL=http://localhost:1488
FRONTEND_PORT=5173
