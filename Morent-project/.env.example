#############################################
# Morent project local docker configuration #
#############################################

# --- ВАЖНО !!! ---
# Советую совсем не менять какие либо здесь данные, чтобы все работало без проблем

# ---- Postgres ----
# user=postgres, password=postgresmaster, db=car_booking, external port=5433
DB_USER=postgres
DB_PASSWORD=postgresmaster
DB_NAME=car_booking
DB_EXTERNAL_PORT=5433

# ---- Backend (вся конфигурация через ENV; файла config.json нет) ----
# HTTP API port (для docker-compose публикации)
BACKEND_PORT=1488
# gRPC
GRPC_PORT=50051
# БД: в docker-compose задаются DB_HOST=db, DB_PORT=5432; локально:
DB_HOST=localhost
DB_PORT=5433
# Агрегатор (см. README про host.docker.internal в Docker Desktop)
AGGREGATOR_BASE_URL=http://host.docker.internal:8080
AGGREGATOR_TIMEOUT_SEC=35
AGGREGATOR_RETRY_COUNT=3
FRONTEND_ORIGIN=http://localhost:5173

# Session cookie settings
SESSION_COOKIE_NAME=morent_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_DOMAIN=

# ---- MinIO ----
# Для локального бэка за пределами Docker укажите MINIO_ENDPOINT=localhost:9000
MINIO_ENDPOINT=localhost:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=morent-media
MINIO_USE_SSL=false
MINIO_PORT_API=9000
MINIO_PORT_CONSOLE=9001

# ---- Redis (кэш списка/фильтра машин) ----
# В docker-compose адрес подставляется в docker-compose.yml (redis:6379).
# Локальный go run: REDIS_ADDR=127.0.0.1:6379 или оставьте пустым — кэш отключён.
REDIS_PORT=6379
REDIS_ADDR=
REDIS_PASSWORD=
REDIS_DB=0
CARS_CACHE_TTL_SEC=60

# ---- Frontend ----
# Browser endpoint for API
VITE_API_URL=http://localhost:1488
FRONTEND_PORT=5173
