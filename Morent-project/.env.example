#############################################
# Morent project local docker configuration #
#############################################

# --- ВАЖНО !!! ---
# Советую совсем не менять какие либо здесь данные, чтобы все работало без проблем

# ---- Postgres ----
# user=postgres, password=postgresmaster, db=car_booking, external port=5433
DB_USER=postgres
DB_PASSWORD=postgresmaster
DB_NAME=car_booking
DB_EXTERNAL_PORT=5433

# ---- Backend ----
# HTTP API port (лучше не менять, если будет использоваться фронт)
BACKEND_PORT=1488
# gRPC port (не менять, используется в бэкенде)
GRPC_PORT=50051
# Optional external car aggregator
# If aggregator runs in Docker on host machine (separate compose),
# backend container must use host.docker.internal instead of localhost.
AGGREGATOR_BASE_URL=http://host.docker.internal:8080
AGGREGATOR_TIMEOUT_SEC=35
AGGREGATOR_RETRY_COUNT=3
FRONTEND_ORIGIN=http://localhost:5173

# Session cookie settings
SESSION_COOKIE_NAME=morent_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_DOMAIN=

# ---- MinIO ----
# endpoint=localhost:9000, access=minioadmin, secret=minioadmin, bucket=morent-media
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=morent-media
MINIO_USE_SSL=false
MINIO_PORT_API=9000
MINIO_PORT_CONSOLE=9001

# ---- Frontend ----
# Browser endpoint for API
VITE_API_URL=http://localhost:1488
FRONTEND_PORT=5173
